@inherits LayoutComponentBase
@inject ThemeState Theme
@implements IDisposable

<MudThemeProvider @bind-IsDarkMode="Theme.IsDarkMode" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <div class="brand-mark">
            <span class="brand-glyph">N</span>
            <MudText Typo="Typo.h6" Class="brand-text">NovaDB</MudText>
        </div>
        <MudSpacer />
        <div class="command-palette-wrap" @onfocusin="OpenJump" @onfocusout="CloseJumpDeferred">
            <MudTextField @bind-Value="_jumpText"
                          @bind-Value:after="OnJumpTextChanged"
                          Placeholder="Jump to page…"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Margin="Margin.None"
                          Immediate="true"
                          Clearable="true"
                          Class="command-palette"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          AdornmentColor="Color.Primary"
                          OnKeyDown="OnJumpKeyDown"
                          OnClearButtonClick="ClearJump"
                          OnAdornmentClick="OpenJump" />
            @if (_jumpOpen && _jumpResults.Count > 0)
            {
                <div class="jump-popover" role="listbox">
                    @for (var i = 0; i < _jumpResults.Count; i++)
                    {
                        var idx = i;
                        var item = _jumpResults[idx];
                        <button type="button"
                                class="jump-option @(_jumpHighlight == idx ? "is-active" : null)"
                                @onmousedown:preventDefault
                                @onclick="() => GoTo(item.Path)">
                            <span class="jump-item-label">@item.Label</span>
                            <span class="jump-item-path">@item.Path</span>
                        </button>
                    }
                </div>
            }
        </div>
        <MudIconButton Icon="@(Theme.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="Theme.Toggle" />
        <form method="post" action="/account/logout">
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit">Logout</MudButton>
        </form>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="app-drawer">
        <div class="drawer-brand">
            <MudText Typo="Typo.overline">Operations</MudText>
            <MudText Typo="Typo.subtitle2">Cache control plane</MudText>
        </div>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/keys" Icon="@Icons.Material.Filled.Key">Keys</MudNavLink>
            <MudNavLink Href="/clients" Icon="@Icons.Material.Filled.People">Clients</MudNavLink>
            <MudNavLink Href="/memory" Icon="@Icons.Material.Filled.Memory">Memory</MudNavLink>
            <MudNavLink Href="/persistence" Icon="@Icons.Material.Filled.Storage">Persistence</MudNavLink>
            <MudNavLink Href="/pubsub" Icon="@Icons.Material.Filled.Campaign">PubSub</MudNavLink>
            <MudNavGroup Title="Observe" Expanded="true">
                <MudNavLink Href="/metrics" Icon="@Icons.Material.Filled.ShowChart">Metrics</MudNavLink>
                <MudNavLink Href="/logs" Icon="@Icons.Material.Filled.ListAlt">Logs</MudNavLink>
                <MudNavLink Href="/health" Icon="@Icons.Material.Filled.Favorite">Health</MudNavLink>
                <MudNavLink Href="/history" Icon="@Icons.Material.Filled.History">History</MudNavLink>
                <MudNavLink Href="/diagnostics" Icon="@Icons.Material.Filled.BugReport">Diagnostics</MudNavLink>
                <MudNavLink Href="/replication" Icon="@Icons.Material.Filled.SyncAlt">Replication</MudNavLink>
                <MudNavLink Href="/performance" Icon="@Icons.Material.Filled.Speed">Performance</MudNavLink>
                <MudNavLink Href="/chaos" Icon="@Icons.Material.Filled.Whatshot">Chaos</MudNavLink>
            </MudNavGroup>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Settings</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string? _jumpText;
    private bool _jumpOpen;
    private int _jumpHighlight;
    private List<(string Path, string Label)> _jumpResults = [];
    private CancellationTokenSource? _closeCts;
    private readonly MudTheme _theme = CreateTheme();
    private static readonly (string Path, string Label)[] Pages =
    [
        ("/", "Dashboard"),
        ("/keys", "Keys"),
        ("/clients", "Clients"),
        ("/memory", "Memory"),
        ("/persistence", "Persistence"),
        ("/pubsub", "PubSub"),
        ("/metrics", "Metrics"),
        ("/logs", "Logs"),
        ("/health", "Health"),
        ("/history", "History"),
        ("/diagnostics", "Diagnostics"),
        ("/replication", "Replication"),
        ("/performance", "Performance"),
        ("/chaos", "Chaos"),
        ("/settings", "Settings")
    ];

    protected override void OnInitialized()
    {
        Theme.Changed += StateHasChanged;
        RefreshJumpResults();
    }

    public void Dispose()
    {
        Theme.Changed -= StateHasChanged;
        _closeCts?.Cancel();
        _closeCts?.Dispose();
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OpenJump()
    {
        _closeCts?.Cancel();
        _jumpOpen = true;
        RefreshJumpResults();
    }

    private async Task CloseJumpDeferred()
    {
        _closeCts?.Cancel();
        _closeCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(160, _closeCts.Token);
            _jumpOpen = false;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Focus moved within the palette; keep open.
        }
    }

    private void OnJumpTextChanged()
    {
        _jumpOpen = true;
        _jumpHighlight = 0;
        RefreshJumpResults();
    }

    private void ClearJump()
    {
        _jumpText = null;
        _jumpHighlight = 0;
        RefreshJumpResults();
        _jumpOpen = true;
    }

    private void RefreshJumpResults()
    {
        var query = (_jumpText ?? string.Empty).Trim();
        IEnumerable<(string Path, string Label)> matches = Pages;
        if (query.Length > 0)
        {
            matches = Pages.Where(p =>
                p.Label.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                p.Path.Contains(query, StringComparison.OrdinalIgnoreCase));
        }

        _jumpResults = matches
            .OrderBy(p => p.Label.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 0 : 1)
            .ThenBy(p => p.Label, StringComparer.OrdinalIgnoreCase)
            .Take(8)
            .ToList();

        if (_jumpHighlight >= _jumpResults.Count)
        {
            _jumpHighlight = Math.Max(0, _jumpResults.Count - 1);
        }
    }

    private async Task OnJumpKeyDown(KeyboardEventArgs e)
    {
        if (!_jumpOpen && (e.Key is "ArrowDown" or "Enter"))
        {
            OpenJump();
        }

        if (_jumpResults.Count == 0)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _jumpHighlight = (_jumpHighlight + 1) % _jumpResults.Count;
                break;
            case "ArrowUp":
                _jumpHighlight = (_jumpHighlight - 1 + _jumpResults.Count) % _jumpResults.Count;
                break;
            case "Enter":
                GoTo(_jumpResults[_jumpHighlight].Path);
                break;
            case "Escape":
                _jumpOpen = false;
                _jumpText = null;
                break;
        }

        await Task.CompletedTask;
    }

    private void GoTo(string path)
    {
        Navigation.NavigateTo(path);
        _jumpText = null;
        _jumpOpen = false;
        _jumpHighlight = 0;
        RefreshJumpResults();
    }

    private static MudTheme CreateTheme() => new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0F766E",
            Secondary = "#0E7490",
            AppbarBackground = "#F4F7F6",
            AppbarText = "#134E4A",
            Background = "#EEF3F1",
            Surface = "#FFFFFF",
            DrawerBackground = "#F7FAF9",
            DrawerText = "#134E4A",
            TextPrimary = "#134E4A",
            TextSecondary = "#5B6B66"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#2DD4BF",
            Secondary = "#22D3EE",
            AppbarBackground = "#0B1412",
            AppbarText = "#E7F5F1",
            Background = "#0A1210",
            Surface = "#121C19",
            DrawerBackground = "#0D1614",
            DrawerText = "#D7E8E2",
            TextPrimary = "#E7F5F1",
            TextSecondary = "#9BB0A8",
            LinesDefault = "#1F2E2A"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["IBM Plex Sans", "Segoe UI", "sans-serif"]
            },
            H4 = new H4Typography
            {
                FontFamily = ["IBM Plex Sans", "Segoe UI", "sans-serif"],
                FontWeight = "600"
            },
            H6 = new H6Typography
            {
                FontFamily = ["IBM Plex Sans", "Segoe UI", "sans-serif"],
                FontWeight = "600"
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        }
    };

    [Inject] private NavigationManager Navigation { get; set; } = default!;
}
