{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NovaDB": "Information"
    }
  },
  "NovaDB": {
    "Port": 6379,
    "HttpPort": 7380,
    "GrpcPort": 7381,
    "BindAddress": "127.0.0.1",
    "MaxConnections": 10000,
    "MemoryLimitBytes": 0,
    "EvictionPolicy": "noeviction",
    "SnapshotInterval": "00:05:00",
    "AofEnabled": true,
    "AofFlushPolicy": "everysec",
    "DataDirectory": "data",
    "SnapshotCompression": false,
    "Password": "",
    "IdleTimeout": "00:05:00",
    "ShardCount": 16
  },
  "AllowedHosts": "*"
}
